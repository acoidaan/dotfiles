# POSICIÓN
anchor=top-right
margin=26
padding=12

# TAMAÑO
width=360
height=110
border-size=1
border-radius=10

# COLORES
background-color=#0c0c0cf2
text-color=#e8e8e8
border-color=#f28fb8

# TEXTO
font=JetBrainsMono Nerd Font 11

# COMPORTAMIENTO
default-timeout=5000
ignore-timeout=1

# ICONOS
icons=1
max-icon-size=42

[urgency=low]
border-color=#fff6d6

[urgency=normal]
border-color=#f28fb8

[urgency=high]
border-color=#f28fb8
default-timeout=0

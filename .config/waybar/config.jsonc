{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces",
	"custom/spotify",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "network",
	"custom/vpn",
	"custom/audio-output",
        "pulseaudio",
        "cpu",
	"temperature",
	"custom/gpu-temp",
        "memory",
        "tray",
	"custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 45
    },

"clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%A, %d %B %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode": "month",
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
            "months": "<b>{}</b>",
            "days": "{}",
            "weeks": "W{}",
            "weekdays": "<b>{}</b>",
            "today": "<b><u>{}</u></b>"
        }
    }
},


    "network": {
        "format-ethernet": "󰈀  Connected",
        "format-disconnected": "󰖪  Offline",
        "tooltip-format": "{ipaddr}",
	"on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
	"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "cpu": {
        "format": "  {usage}%"
    },

    "memory": {
        "format": "  {percentage}%"
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
},

"temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 85,
    "format": "󰔏  {temperatureC}°C"
},

"custom/gpu-temp": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
    "format": "󰢮  {}°C",
    "interval": 5,
    "tooltip": false
},

"custom/spotify": {
    "exec": "playerctl --player=spotify metadata --format '󰓇  {{artist}} — {{title}}' 2>/dev/null",
    "interval": 2,
    "max-length": 45,
    "escape": true,
    "on-click": "playerctl --player=spotify play-pause",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous",
    "tooltip": false
},

"custom/audio-output": {
    "exec": "~/.config/hypr/scripts/audio-status.sh",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Cambiar salida de audio",
    "on-click": "~/.config/hypr/scripts/audio-output.sh"
},

"custom/vpn": {
    "exec": "~/.config/hypr/scripts/vpn-status.sh",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Proton VPN",
    "on-click": "protonvpn-app"
}


}

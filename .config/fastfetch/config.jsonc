{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/lily.txt",
      "color": {
          "1": "255;239;184"
      },
      "padding": {
          "top": 2,
          "right": 5,
          "left": 2
      }
},
"display": {
    "color": {
        "keys": "#F28FB8",
        "title": "#F8C8DC",
        "output": "#E8E8E8",
        "separator": "#FFF6D6"
    },
    "percent": {
        "color": {
            "green": "#F8C8DC",
            "yellow": "#F4D35E",
            "red": "#F28FB8"
        }
    }
},
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "poweradapter",
    "localip",
    "break",
    "colors"
  ]
}
